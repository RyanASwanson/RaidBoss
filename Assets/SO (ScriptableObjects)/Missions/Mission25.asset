  _missionDisplayHighlights: []
  _tutorialPages:
  - TutorialPageTitle: 'Boss: The Void Lord'
    TutorialPageTitleWidth: 1068
    DefaultTextLocation: {x: 0, y: 40}
    DefaultText: 'A new foe has appeared. The <color=#8F51FF>Void

      Lord</color>
      calls upon the madness

      within the void to drain the hope

      from
      your Heroes.'
    TutorialPageObjectLocation: {x: 0, y: 0}
    TutorialPageObject: {fileID: 0}
    TutorialPageCharacterTutorial:
      TutorialCharacterIconLocation: {x: 0, y: -60}
      TutorialCharacterIconScaleMultiplier: 1.075
      TutorialPageCharacterIcon: {fileID: 21300000, guid: a46309a0afc9f494585361ffa3fb838a, type: 3}
      TutorialPageCharacterBackground: {fileID: 21300000, guid: b2bea2ea6395a3a4698f324d28df7139, type: 3}
  - TutorialPageTitle: Fading Hope
    TutorialPageTitleWidth: 685
    DefaultTextLocation: {x: 0, y: 38}
    DefaultText: 'The <color=#8F51FF>Void Lord</color> will occasionally

      use
      <color=#7D48DE>Fading Hope</color>, which deals

      damage to all Heroes.'
    TutorialPageObjectLocation: {x: 0, y: 0}
    TutorialPageObject: {fileID: 0}
    TutorialPageCharacterTutorial:
      TutorialCharacterIconLocation: {x: 0, y: -65}
      TutorialCharacterIconScaleMultiplier: 1
      TutorialPageCharacterIcon: {fileID: 21300000, guid: 9b676d33e1073e146b6919d53cb09fbc, type: 3}
      TutorialPageCharacterBackground: {fileID: 21300000, guid: e1908552323c2764f9a06cd60265194a, type: 3}
  - TutorialPageTitle: Rays of Hope
    TutorialPageTitleWidth: 709
    DefaultTextLocation: {x: 0, y: 53}
    DefaultText: 'Hope is not lost yet. The <color=#8F51FF>Void Lord</color>

      also
      spawns <color=#7D48DE>Rays of Hope</color> with its other

      abilities.
      <color=#7D48DE>Rays of Hope</color> restore health to

      the Hero that
      touches them.'
    TutorialPageObjectLocation: {x: 0, y: -53}
    TutorialPageObject: {fileID: 67691793726138335, guid: daf7da7a088e70f45acd39ce4a8dc4d3, type: 3}
    TutorialPageCharacterTutorial:
      TutorialCharacterIconLocation: {x: 0, y: -65}
      TutorialCharacterIconScaleMultiplier: 1
      TutorialPageCharacterIcon: {fileID: 0}
      TutorialPageCharacterBackground: {fileID: 0}
  - TutorialPageTitle: Buff Target Zones
    TutorialPageTitleWidth: 1021
    DefaultTextLocation: {x: 0, y: 53}
    DefaultText: 'Boss abilities that provide buffs or

      healing to Heroes,
      such as <color=#7D48DE>Rays of Hope</color>,

      have green target zones
      to signify

      the positive effect.'
    TutorialPageObjectLocation: {x: 0, y: -54}
    TutorialPageObject: {fileID: 2377917332233223092, guid: 0455dd200afd3d145b41eb114e3ac37f, type: 3}
    TutorialPageCharacterTutorial:
      TutorialCharacterIconLocation: {x: 0, y: -65}
      TutorialCharacterIconScaleMultiplier: 1
      TutorialPageCharacterIcon: {fileID: 0}
      TutorialPageCharacterBackground: {fileID: 0}
  - TutorialPageTitle: Destroyed Hope
    TutorialPageTitleWidth: 855
    DefaultTextLocation: {x: 0, y: 55}
    DefaultText: 'Be careful as some abilities

      can destroy <color=#7D48DE>Rays
      of Hope</color>. A

      target zone turning yellow means

      the ability
      will destroy a <color=#7D48DE>Ray</color>.'
    TutorialPageObjectLocation: {x: 0, y: -54}
    TutorialPageObject: {fileID: 3246850205187242559, guid: 399e52d0d17363a40b8ceca5c1e9c5fd, type: 3}
    TutorialPageCharacterTutorial:
      TutorialCharacterIconLocation: {x: 0, y: -65}
      TutorialCharacterIconScaleMultiplier: 1
      TutorialPageCharacterIcon: {fileID: 0}
      TutorialPageCharacterBackground: {fileID: 0}
