  _tutorialPages:
  - TutorialPageTitle: Despair Hex
    TutorialPageTitleWidth: 1321
    DefaultTextLocation: {x: 0, y: 40}
    DefaultText: 'The <color=#8F51FF>Void Lord</color> can use

      Despair Hex
      to apply a debuff to Heroes.

      Affected Heroes take damage from

      Rays
      of Hope instead of healing.'
    TutorialPageObjectLocation: {x: 0, y: 0}
    TutorialPageObject: {fileID: 0}
    TutorialPageCharacterTutorial:
