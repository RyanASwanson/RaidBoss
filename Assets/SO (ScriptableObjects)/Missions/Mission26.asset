      TutorialPageCharacterBackground: {fileID: 21300000, guid: b2bea2ea6395a3a4698f324d28df7139, type: 3}
  - TutorialPageTitle: Debuff Target Zones
    TutorialPageTitleWidth: 1170
    DefaultTextLocation: {x: 0, y: 54}
    DefaultText: 'Boss abilities that provide debuffs

      to Heroes such as <color=#7D48DE>Despair
      Hex</color>,

      have purple target zones to signify

      the negative
      effect.'
    TutorialPageObjectLocation: {x: 0, y: -56}
    TutorialPageObject: {fileID: 9001945850931321933, guid: 53d77ade249658443b5314e13aadeb33, type: 3}
    TutorialPageCharacterTutorial:
      TutorialCharacterIconLocation: {x: 0, y: -65}
      TutorialCharacterIconScaleMultiplier: 1
      TutorialPageCharacterIcon: {fileID: 0}
      TutorialPageCharacterBackground: {fileID: 0}
  - TutorialPageTitle: Transferring Despair
    TutorialPageTitleWidth: 1200
    DefaultTextLocation: {x: 0, y: 56}
    DefaultText: 'If <color=#7D48DE>Despair Hex</color> contacts

      another Hero,
      the effect will

      transfer to that Hero instead.'
    TutorialPageObjectLocation: {x: 0, y: -49}
    TutorialPageObject: {fileID: 9001945850931321933, guid: f7d4dddaea229cf4c954172871f3d4d0, type: 3}
