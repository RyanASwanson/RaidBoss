  _tutorialPages:
  - TutorialPageTitle: Despair Hex
    TutorialPageTitleWidth: 693
    DefaultTextLocation: {x: 0, y: 40}
    DefaultText: 'The <color=#8F51FF>Void Lord</color> can use

      <color=#7D48DE>Despair
      Hex</color> to apply a debuff to Heroes.

      Affected Heroes take damage
      from

      <color=#7D48DE>Rays of Hope</color> instead of healing.'
    TutorialPageObjectLocation: {x: 0, y: 0}
    TutorialPageObject: {fileID: 0}
    TutorialPageCharacterTutorial:
      TutorialCharacterIconLocation: {x: 0, y: -60}
      TutorialCharacterIconScaleMultiplier: 1.075
