  - TutorialPageTitle: Debuff Target Zones
    TutorialPageTitleWidth: 956
    DefaultTextLocation: {x: 0, y: 35}
    DefaultText: 'Boss abilities that provide debuffs

      to Heroes such as <color=#6B3CBD>Despair
      Hex</color>

      have purple target zones to signify

      the negative
      effect.'
    TutorialPageObjectLocation: {x: 0, y: 0}
    TutorialPageObject: {fileID: 0}
    TutorialPageCharacterTutorial:
      TutorialCharacterIconLocation: {x: 0, y: -65}
      TutorialCharacterIconScaleMultiplier: 1
      TutorialPageCharacterIcon: {fileID: 21300000, guid: 9b676d33e1073e146b6919d53cb09fbc, type: 3}
      TutorialPageCharacterBackground: {fileID: 21300000, guid: e1908552323c2764f9a06cd60265194a, type: 3}
  - TutorialPageTitle: Transferring Despair
    TutorialPageTitleWidth: 956
    DefaultTextLocation: {x: 0, y: 35}
    DefaultText: 'If <color=#6B3CBD>Despair Hex</color> contacts

      another Hero,
      the effect will transfer

      to that Hero instead.'
    TutorialPageObjectLocation: {x: 0, y: 0}
    TutorialPageObject: {fileID: 0}
